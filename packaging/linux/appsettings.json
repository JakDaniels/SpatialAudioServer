{
  // /etc/spatialaudioserver/appsettings.json: settings for this server. They apply on top of the program's defaults
  // (/usr/lib/spatialaudioserver/appsettings.json, replaced on upgrade); this file is yours and is kept.
  // All settings: /usr/share/doc/spatialaudioserver/configuration.md. For an internet-facing host: internet.md.
  // Restart after changing: sudo systemctl restart spatialaudioserver
  //
  // WebRTC media uses this UDP port range (and TCP, for ICE-TCP): open it in the firewall, with TCP 5000-5001.
  "Media": { "Network": { "MinPort": 40000, "MaxPort": 40999 } }
  //
  // More examples (move them inside the braces above, with a comma between):
  // "Server": { "HttpPort": 5000, "HttpsPort": 5001,
  //             "CertificatePath": "/etc/letsencrypt/live/example.org/fullchain.pem",
  //             "CertificateKeyPath": "/etc/letsencrypt/live/example.org/privkey.pem" },
  // "Media": { "Network": { "PublicAddress": "203.0.113.10" } } (with the range above: one "Media" section),
  // "Admin": { "AllowedNetworks": [ "192.168.1.0/24" ] }
}
