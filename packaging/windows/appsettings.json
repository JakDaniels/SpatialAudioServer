{
  // C:\ProgramData\SpatialAudioServer\appsettings.json: settings for this server. They apply on top of the program's
  // defaults (C:\Program Files\SpatialAudioServer\appsettings.json, replaced on upgrade); this file is yours and is
  // kept on upgrade and uninstall. All settings: docs\configuration.md in the program folder; internet-facing hosts:
  // docs\internet.md. Restart after changing: Restart-Service SpatialAudioServer
  //
  // WebRTC media uses this UDP port range, which the installer's optional firewall rules open (with TCP 5000-5001).
  "Media": { "Network": { "MinPort": 40000, "MaxPort": 40999 } }
  //
  // More examples (move them inside the braces above, with a comma between):
  // "Server": { "HttpPort": 5000, "HttpsPort": 5001,
  //             "CertificatePath": "C:\\certs\\fullchain.pem", "CertificateKeyPath": "C:\\certs\\privkey.pem" },
  // "Admin": { "AllowedNetworks": [ "192.168.1.0/24" ] }
}
