<!-- The load tool MSI (PACKAGING-PLAN.md "Windows installers"). Built by scripts\build-windows.ps1. -->
<Project Sdk="WixToolset.Sdk/6.0.2">
  <PropertyGroup>
    <OutputName>SpatialAudioServer-LoadTest</OutputName>
    <InstallerPlatform>x64</InstallerPlatform>
    <DefineConstants>ProductVersion=$(ProductVersion);Stage=$(Stage);Here=$(MSBuildThisFileDirectory)..</DefineConstants>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="6.0.2" />
  </ItemGroup>
</Project>
