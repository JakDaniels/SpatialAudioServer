<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- Phase 0 spike: browser offer -> server answer, Opus in -> echoed back out.
       Not part of the product build; see README.md. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>WebRtcEcho</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="GstSharp.Net" Version="1.28.17" />
    <PackageReference Include="GstSharp.Net.Sdp" Version="1.28.17" />
    <PackageReference Include="GstSharp.Net.WebRTC" Version="1.28.17" />
  </ItemGroup>

</Project>
