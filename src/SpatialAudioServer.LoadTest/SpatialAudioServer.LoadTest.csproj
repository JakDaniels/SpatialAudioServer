<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\SpatialAudioServer\SpatialAudioServer.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="GstSharp.Net.App" Version="1.28.17" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
  </PropertyGroup>

  <!-- GstSharp.Net is LGPL-2.1-or-later (NOTICE): in a single-file publish its assemblies stay beside the program as
       separate files that can be replaced, as that licence asks, instead of going into the bundle. -->
  <Target Name="KeepLgplAssembliesOutsideTheBundle" AfterTargets="ComputeResolvedFilesToPublishList">
    <ItemGroup>
      <_LgplAssembly Include="@(ResolvedFileToPublish)" Condition="$([System.String]::Copy('%(Filename)').StartsWith('GstSharp.Net'))" />
      <ResolvedFileToPublish Remove="@(_LgplAssembly)" />
      <ResolvedFileToPublish Include="@(_LgplAssembly)" ExcludeFromSingleFile="true" />
    </ItemGroup>
  </Target>

</Project>
